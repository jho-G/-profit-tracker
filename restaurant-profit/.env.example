# ============================================================
# Liyu Shiro (ልዩ ሽሮ) Profit Tracker & Digital Menu
# Environment Variables Configuration Template
# ============================================================

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Supabase Public / Anonymous Key (safe for browser & public menu projection)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Supabase Service Role Key (Keep secret! Used ONLY by server-side APIs for admin operations)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
